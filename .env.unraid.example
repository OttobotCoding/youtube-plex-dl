# ─── UNRAID ───────────────────────────────────────────────────────────────
# cp .env.unraid.example .env   →   docker compose up -d --build
#
# This is the ONLY file that differs from your local test setup.
# docker-compose.yml itself is byte-for-byte the same.

# Prebuilt image from GitHub Container Registry — no source code, no compiler
# and no build step needed on the array. Replace with YOUR github username.
# Pin a version (…:v1.0.0) instead of :latest if you want updates to be a
# deliberate act rather than automatic.
IMAGE=ghcr.io/msmigiel22/youtube-plex-dl:latest

# How often Watchtower checks for a new image, in seconds (86400 = daily).
# Only used if you started it with:  docker compose --profile autoupdate up -d
WATCHTOWER_POLL_INTERVAL=86400

# MEDIA_PATH must be the ROOT of the Plex "TV Shows" library for YouTube —
# the same host share Plex is scanning.
MEDIA_PATH=/mnt/user/media/YouTube
APPDATA_PATH=/mnt/user/appdata/youtube-plex-dl

# Change if 8080 is already taken on the array.
WEBUI_PORT=8080

# Unraid's nobody:users. Match whatever your Plex container writes as.
PUID=99
PGID=100
UMASK=002
TZ=America/Denver

# 0 = best available (includes 4K/8K where offered). 1080 keeps files sane.
MAX_HEIGHT=0
CONCURRENCY=2

SEASON_MODE=single
SEASON_NUMBER=1
TITLE_INCLUDE_DATE=true

# Gmail needs a 16-character App Password, not your account password.
NOTIFY_EMAIL=true
NOTIFY_MODE=batch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=msmigiel22@gmail.com
SMTP_PASS=CHANGEME-app-password
SMTP_FROM=msmigiel22@gmail.com
SMTP_TO=msmigiel22@gmail.com

# Uncomment if YouTube starts asking you to prove you're not a bot.
#COOKIES_FILE=/config/cookies.txt

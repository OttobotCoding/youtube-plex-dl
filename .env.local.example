# ─── LOCAL TESTING ────────────────────────────────────────────────────────
# cp .env.local.example .env   →   docker compose up --build
#
# Only host-specific things live here. Everything else falls back to the
# defaults baked into docker-compose.yml.

# Where files land on THIS machine. Relative paths are fine — they resolve
# next to docker-compose.yml, and both folders are gitignored.
MEDIA_PATH=./data/downloads
APPDATA_PATH=./data/config

# Pick any free port on your laptop.
WEBUI_PORT=8080

# Run as YOU, not as Unraid's nobody:users — otherwise ./data ends up owned
# by uid 99 and you can't open the files without sudo.
# Find your values with:  id -u  and  id -g   (usually 1000 / 1000)
PUID=1000
PGID=1000
UMASK=002
TZ=America/Denver

# Cap quality so test downloads finish in seconds instead of minutes.
# Delete this line (or set 0) when you want real quality.
MAX_HEIGHT=360
CONCURRENCY=2

# Naming — keep this IDENTICAL to your Unraid .env so what you see locally is
# what you get on the array.
SEASON_MODE=single
SEASON_NUMBER=1
TITLE_INCLUDE_DATE=true

# Email off while testing; flip to true and fill in SMTP_* to test it.
NOTIFY_EMAIL=false
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=msmigiel22@gmail.com
#SMTP_PASS=your-16-char-app-password
#SMTP_FROM=msmigiel22@gmail.com
#SMTP_TO=msmigiel22@gmail.com

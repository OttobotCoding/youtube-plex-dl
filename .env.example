# Full reference of every setting. For day-to-day use start from one of the
# two short files instead:
#   cp .env.local.example  .env     # testing on your laptop
#   cp .env.unraid.example .env     # running on the array
# docker-compose reads .env automatically.

# ---- HOST paths + port (the ONLY things that differ local vs Unraid) ---
# Local:  ./data/downloads          Unraid: /mnt/user/media/YouTube
# Local:  ./data/config             Unraid: /mnt/user/appdata/youtube-plex-dl
MEDIA_PATH=./data/downloads
APPDATA_PATH=./data/config
WEBUI_PORT=8080

# ---- ownership --------------------------------------------------------
# Unraid: 99/100. Local: your own `id -u` / `id -g`, usually 1000/1000.
PUID=99
PGID=100
UMASK=002
TZ=America/Denver

# ---- container-side paths (leave these alone; map MEDIA_PATH instead) --
OUTPUT_DIR=/downloads
CONFIG_DIR=/config
PORT=8080
APP_TITLE=YouTube → Plex

# ---- Plex naming ------------------------------------------------------
# single: <Channel>/Season 01/<Channel> - S01E07 - <Title> (2026-08-29).mp4
# year:   <Channel>/Season 2026/<Channel> - S2026E0829 - <Title> (2026-08-29).mp4
SEASON_MODE=single
SEASON_NUMBER=1
TITLE_INCLUDE_DATE=true
FILENAME_MAX_LEN=150

# ---- download ---------------------------------------------------------
MERGE_FORMAT=mp4
MAX_HEIGHT=0
CONCURRENCY=2
EMBED_METADATA=true
EMBED_THUMBNAIL=true
WRITE_THUMBNAIL=true
WRITE_CHANNEL_POSTER=true
WRITE_NFO=true
SUBTITLES=true
SUBTITLE_LANGS=en.*
SUBTITLE_AUTO=true
EMBED_SUBTITLES=true
WRITE_SUBTITLE_FILES=true
SPONSORBLOCK=false
#RATE_LIMIT=10M
#COOKIES_FILE=/config/cookies.txt

# ---- discovery --------------------------------------------------------
PROBE_LIMIT=60
CHANNEL_PANEL_LIMIT=24

# ---- email ------------------------------------------------------------
NOTIFY_EMAIL=false
NOTIFY_MODE=batch
NOTIFY_ON_FAILURE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com
